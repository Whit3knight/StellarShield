# env files (can opt-in for committing if needed)
.env*
!.env.example

# keeper hot-key env — NEVER commit (matches deploy/keeper.env + deploy/docker/keeper.env).
# keeper.env.example is a different name and stays tracked.
keeper.env

# Vercel CLI local project link (contains org/project ids) — never commit.
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust / soroban contracts
/contracts/target
/contracts/**/target
Cargo.lock

# circom circuit build artifacts (local dev ceremony outputs; the published
# proving/verification artifacts live in public/circuits-circom and
# contracts/borrow-pool/src/vk, which stay tracked)
/contracts/circuits/**/node_modules
/contracts/circuits/**/build

# playwright mcp scratch
/.playwright-mcp
