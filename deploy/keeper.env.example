# Stellar Shield liquidation keeper env — copy to /etc/stellar-shield/keeper.env
# root-owned, chmod 600. NEVER commit the real file.
#
#   sudo install -m600 deploy/keeper.env.example /etc/stellar-shield/keeper.env
#   sudo $EDITOR /etc/stellar-shield/keeper.env

# --- Chain config ---
STELLAR_SHIELD_CONTRACT_ID=CBVBVB6LGQJYO2KTIHB6VMJEZ3CHHC4KPIJ7EATV4SR7CTC7TUE6PM2P
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_REFLECTOR_CEX_CONTRACT_ID=

# --- Optional tuning ---
# EVENTS_API_URL= (full URL to a deployed /api/events — merges indexed events past RPC retention)
# LIQUIDATION_THRESHOLD_BPS=

# --- HOT KEYS (only needed for authenticated / --trigger mode) ---
# LIQUIDATION_SERVICE_SK: 32-byte hex service key (authenticated triage).
LIQUIDATION_SERVICE_SK=
# LIQUIDATOR_SECRET: Stellar secret (S...) that funds + signs liquidations.
# Required by --trigger. Fund it minimally. Omit both for read-only watchlist.
LIQUIDATOR_SECRET=
