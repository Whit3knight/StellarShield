# systemd unit — Stellar Shield web app (next start).
# Install:  sudo cp deploy/stellar-shield.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now stellar-shield
#
# Runs as an unprivileged user. The app is NON-CUSTODIAL — it holds no keys or
# funds, so this unit carries no secrets. NEXT_PUBLIC_* config is baked into the
# build in CI, not read here at runtime.

[Unit]
Description=Stellar Shield (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/srv/stellar-shield/current
# Adjust if bun lives elsewhere (oven-sh installer puts it in ~/.bun/bin).
ExecStart=%h/.bun/bin/bun run start
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Restart=always
RestartSec=5

# Hardening — the web tier touches no secrets, so lock it down.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/stellar-shield
PrivateTmp=true

[Install]
WantedBy=multi-user.target
