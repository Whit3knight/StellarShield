# BUILD-TIME env for Stellar Shield.
#
# These are NEXT_PUBLIC_* vars — Next.js inlines them into the client bundle at
# `next build`. That means they must be present in CI when the build runs, NOT
# on the runtime VPS. Set them as GitHub Actions repository *variables* (public
# config) or *secrets* (WalletConnect id) — see .github/workflows/deploy.yml.
#
# Nothing here is a private key; these are public chain identifiers.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SHIELD_CONTRACT_ID=CATPLYDPXDFBSLOUP4YQK5BZLGRBYTUXSTZMIXLMBHAPAR6K4JEP52YX
NEXT_PUBLIC_STELLAR_REFLECTOR_CEX_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_REFLECTOR_FX_CONTRACT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
