# BUILD-TIME env for Stellar Shield.
#
# These are NEXT_PUBLIC_* vars — Next.js inlines them into the client bundle at
# `next build`. They belong wherever the BUILD runs, never on a runtime box.
#
#   Vercel (default web tier):  set these in Vercel -> Settings -> Environment
#   Variables. WalletConnect id can go in the same place.
#
#   Self-host alternative:      set them as GitHub Actions repository *variables*
#   (and the WalletConnect id as a *secret*) — see .github/workflows/deploy.yml.
#
# Nothing here is a private key; these are public chain identifiers.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SHIELD_CONTRACT_ID=CCNLBMUTHMO5SXRBJ5DIKZDSS3J3OEW4PB5UFWATEXWLEDBGOBIEAEIZ
NEXT_PUBLIC_STELLAR_REFLECTOR_CEX_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_REFLECTOR_FX_CONTRACT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
