NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Protocol adapter. Leave unset to keep the mock adapter. Set to "soroban"
# with a deployed contract id to route through the real Soroban RPC.
NEXT_PUBLIC_STELLAR_SHIELD_ADAPTER=
# Testnet deploy from 2026-07-10 (borrow-pool skeleton, pre-audit):
# CDOQVJ75M4EZAS7MX6ADUIHJCEMSUUSL2ABAS3LO2LZTQ7FFLRGS2DTI
NEXT_PUBLIC_STELLAR_SHIELD_CONTRACT_ID=

# Prover. Leave unset for mock. Options:
#   - "noir"    — Noir + Barretenberg UltraHonk. Currently blocked by
#                 an upstream `RuntimeError: unreachable` in
#                 bb 5.0.0-nightly.
#   - "snarkjs" — Circom + snarkjs Groth16 over BN254 with the
#                 Nethermind/SDF Soroban verifier. Recommended path.
#                 Requires:
#                   * circom compiler installed locally
#                   * compiled artefacts vendored at
#                     public/circuits-circom/borrow_eligibility.wasm
#                     public/circuits-circom/borrow_eligibility.zkey
#                   See contracts/circuits/borrow-eligibility-circom/README.md
NEXT_PUBLIC_STELLAR_SHIELD_PROVER=
