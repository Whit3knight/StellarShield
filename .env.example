NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical shielded pool contract (testnet). This value is the source of
# truth; README and the CLI script fallbacks must match it. Leave unset to
# fall back to the bindings default (features/protocol/bindings/borrow-pool.ts).
NEXT_PUBLIC_STELLAR_SHIELD_CONTRACT_ID=CDYTGIGPCTYKTNYFVN2MUAKNMX5VO6RHP6HQQKWZOGXWKNKBQJWKJABU

# Reflector oracle contract IDs (testnet defaults). Source:
# https://developers.stellar.org/docs/data/oracles/oracle-providers.
# CEX/DEX feed covers crypto tickers (XLM, USDC). FX feed covers fiat
# (EUR for EURC). Leave unset to fall back to static hardcoded prices.
NEXT_PUBLIC_STELLAR_REFLECTOR_CEX_CONTRACT_ID=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
NEXT_PUBLIC_STELLAR_REFLECTOR_FX_CONTRACT_ID=CCSSOHTBL3LEWUCBBEB5NJFC2OKFRC74OWEIJIZLRJBGAAU4VMU5NV4W

# Indexed events (Goldsky -> Neon). Both optional — unset means RPC-only.
# DATABASE_URL=postgres://... (server-only; Neon pooled string — enables /api/events indexer route)
# EVENTS_API_URL= (CLI / non-browser scans: full URL to a deployed /api/events)
